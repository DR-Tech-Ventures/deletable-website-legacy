NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
BETA_PASSWORD=your_beta_password_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# Sentry — get DSN from sentry.io after creating a Next.js project
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Upstash Redis — rate limiting for contact form (optional, disables rate limiting if not set)
# Create a Redis database at upstash.com or via Vercel Marketplace > Upstash
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
